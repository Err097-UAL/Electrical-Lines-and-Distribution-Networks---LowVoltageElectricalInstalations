function results = H1_Radial_Analysis()
% =========================================================================
% FUNCTION: Main Radial Network Analysis (V4 - With Optimization)
% =========================================================================
% MODIFIED: Standardized menu function call to 'centeredMenu3'.
% =========================================================================

clc;
results = []; 
%global U_source;
% --- Get common inputs ---
% UPDATED: Changed centeredMenu32 to centeredMenu3
scenarioChoice = centeredMenu3('Select Radial Network Scenario:', ...
    'Industrial Estate (Concentrated Loads)', ...
    'Residential Area (Distributed Loads)', ...
    'Street Lighting (Uniform Loads)');
if scenarioChoice == 0, return; end

U_source = input('Enter source line-to-neutral voltage [V] (e.g., 230): ');
% UPDATED: Changed centeredMenu32 to centeredMenu3
lineTypeChoice = centeredMenu3('Select System Type:', 'Single-Phase', 'Three-Phase');
if lineTypeChoice == 1, phase_factor = 2; else, phase_factor = 1; end
% UPDATED: Changed centeredMenu32 to centeredMenu3
materialChoice = centeredMenu3('Select Conductor Material:', 'Copper', 'Aluminum');
if materialChoice == 0, return; end
if materialChoice == 1, materialName = 'Copper'; else, materialName = 'Aluminum'; end

% --- Get remaining inputs and perform calculations (code unchanged) ---
materialProps = getMaterialProperties(materialName);
conductivity = materialProps.conductivity; 
crossSection = input('Enter conductor cross-section [mm^2]: '); 
loads = getLoads(scenarioChoice, U_source); 
results.scenarioName = getScenarioName(scenarioChoice);
results.U_source = U_source;
results.materialName = materialName;
results.conductivity = conductivity; % Store conductivity
results.crossSection = crossSection;
results.loads = loads;

% Perform voltage drop calculation
num_loads = length(loads);
for i = 1:num_loads
    current_in_segment = sum([loads(i:end).current]);
    drop_segment = (phase_factor / (conductivity * crossSection)) * current_in_segment * loads(i).length;
    if i == 1
        results.loads(i).voltageDrop = drop_segment;
    else
        results.loads(i).voltageDrop = results.loads(i-1).voltageDrop + drop_segment;
    end
    results.loads(i).voltage = U_source - results.loads(i).voltageDrop;
end

% --- Determine Operation Mode ---
% Decide if this is analysis or design based on context or add menu here if needed
% For now, assume analysis mode for compatibility
% if modeChoice == 2 % Design/Optimize Mode
%     % Call optimization function (H4_OptimizeRadialNetwork)
%     base_results = results; % Pass current results to optimizer
%     % NOTE: H4_OptimizeRadialNetwork needs to be defined or implemented
%     % results = H4_OptimizeRadialNetwork(base_results); 
% end

% Plot profile if a valid result was found
if ~isempty(results)
    % NOTE: H2_PlotRadialProfile needs to be defined or implemented
    % H2_PlotRadialProfile(results); 
    disp('Analysis complete. Plotting function H2_PlotRadialProfile needs implementation.');
end

end

% --- Helper sub-functions ---
function loads = getLoads(scenarioChoice, U_source)
    % Simplified load input based on scenario (as previously defined)
    if scenarioChoice == 1 % Concentrated
        num_loads = input('Enter the number of loads/nodes: ');
        loads(num_loads) = struct('length', 0, 'current', 0, 'voltage', 0, 'distance', 0);
        total_dist = 0;
        for i = 1:num_loads
            fprintf('--- Node %d ---\n', i);
            loads(i).length = input(['Enter length of segment leading to node ' num2str(i) ' [m]: ']);

          %  loads(i).current = input(['Enter current of load at node ' num2str(i) ' [A]: ']);
            loadPower = input(['enter Power usage at load [kW]']);
            cos_phi = input (['Enter Power Factor at load (E.g. 0.80)']);
            loads(i).current = loadPower*1000/((sqrt(3))*cos_phi*U_source);
            total_dist = total_dist + loads(i).length;
            loads(i).distance = total_dist;
        end
    else % Distributed (Residential or Street Lighting)
        total_length = input('Enter total length of the line [m]: ');
      
   %  total_current = input('Enter total distributed current [A]: ');
        total_Power = input('Enter total Power consumption [kW]');
        cos_phi = input('Enter Power Factor (E.G. 0.97)');
        total_current = total_Power*1000/((sqrt(3))*U_source*cos_phi)
        num_segments = 20; % Approximate as 20 segments
        loads(num_segments) = struct('length', 0, 'current', 0, 'voltage', 0, 'distance', 0);
        total_dist = 0;
        for i = 1:num_segments
            loads(i).length = total_length / num_segments;
            loads(i).current = total_current / num_segments;
             total_dist = total_dist + loads(i).length;
            loads(i).distance = total_dist;
        end
    end
end

function name = getScenarioName(choice)
    names = {'Industrial Estate', 'Residential Area', 'Street Lighting'};
    if choice >= 1 && choice <= length(names)
        name = names{choice};
    else
        name = 'Unknown Scenario';
    end
end

