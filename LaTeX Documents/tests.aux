\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparison of insulation resistance decay for PVC and XLPE (More Curved Decay Model).}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Initial material cost per kilometer.}}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Estimated 30-year operating cost due to energy losses, based on assumed load (100A), area (50mm²), temp (50°C), and price (€0.15/kWh). For comparative purposes only.\footnote {Energy loss calculation: Power loss per phase is $P_{loss} = I^2 R$. For a balanced 3-phase system, total power loss is $P_{total} = 3 \times I^2 R$. Total energy loss over a period is $E_{loss} = P_{total} \times \text  {time} = 3 \times I^2 R \times \text  {time}$. $R$ is the resistance per km at the assumed operating temperature.}}}{2}{}\protected@file@percent }
